# LeadForge environment configuration.
# Copy to .env and fill in values. Never commit .env with real secrets.
# SQLite is the default — DATABASE_URL is only needed for PostgreSQL.

# --- Database ---
# Leave commented for zero-setup SQLite mode.
# DATABASE_URL=postgresql+psycopg2://leadforge:leadforge@localhost:5432/leadforge

# --- Research providers ---
# Demo provider needs no credentials.
LEADFORGE_PROVIDER=demo
# HTTP provider (skeleton in v1): set these only when wiring a legitimate API.
# LEADFORGE_HTTP_API_KEY=
# LEADFORGE_HTTP_API_BASE_URL=

# --- AI enrichment (optional) ---
# Unset/disabled by default; the app works fully without an LLM key.
LEADFORGE_AI_ENABLED=false
# LEADFORGE_LLM_PROVIDER=openai
# LEADFORGE_LLM_API_KEY=
# LEADFORGE_LLM_MODEL=

# --- Demo ---
LEADFORGE_DEMO_SEED=42
LEADFORGE_DEMO_DELAY_MS=120

# --- App ---
LEADFORGE_ENV=development
LEADFORGE_LOG_LEVEL=INFO
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000

# --- Docker Compose PostgreSQL (used only by `docker compose up`) ---
POSTGRES_USER=leadforge
POSTGRES_PASSWORD=leadforge
POSTGRES_DB=leadforge
